+    .split(/(?<=[.!?])\s+/)[0]
+    ?.trim();
+
+  const shortSummary =
+    summary && summary.length > 86
+      ? `${summary.slice(0, 83).trimEnd()}…`
+      : summary;
+
+  return `Yeni görev tanımlandı · +${task.rewardPoints} Pusula Puanı${
+    shortSummary ? ` · ${shortSummary}` : ''
+  }`;
 }
 
